# Use an image that supports Java 25
FROM openjdk:25-ea-jdk-slim 

# Set the working directory
WORKDIR /app

# Copy your built JAR file
COPY target/configserver-0.0.1-SNAPSHOT.jar ConfigServer.jar

# Copy the configurations folder from your project root
# This matches: spring.cloud.config.server.native.search-locations=file:./configurations
COPY configurations/ ./configurations/

# Expose the default Config Server port
EXPOSE 8012

ENTRYPOINT ["java", "-jar", "ConfigServer.jar"]